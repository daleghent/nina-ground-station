<UserControl
    x:Class="DaleGhent.GroundStation.Utilities.GsExprTextBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="root"
    VerticalAlignment="Center">
    <TextBox
        MinWidth="40"
        Margin="5,0,0,0"
        Padding="5,0,5,0"
        HorizontalAlignment="{Binding HorizontalAlignment, ElementName=root}"
        VerticalAlignment="{Binding VerticalAlignment, ElementName=root}"
        VerticalContentAlignment="{Binding VerticalAlignment, ElementName=root}"
        VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility}"
        AcceptsReturn="{Binding AcceptsReturn, ElementName=root}"
        AcceptsTab="{Binding AcceptsTab, ElementName=root}"
        Text="{Binding Text, ElementName=root, UpdateSourceTrigger=LostFocus}"
        TextAlignment="{Binding TextAlignment, ElementName=root}"
        TextWrapping="{Binding TextWrapping, ElementName=root}"
        ToolTip="{Binding ProcessedText, ElementName=root}">
        <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="35" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AcceptsReturn, ElementName=root}" Value="True">
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="MinHeight" Value="35" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBox.Style>
    </TextBox>
</UserControl>
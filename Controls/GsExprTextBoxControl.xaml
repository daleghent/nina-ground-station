<UserControl
    x:Class="DaleGhent.NINA.GroundStation.Controls.GsExprTextBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gslogic="clr-namespace:DaleGhent.NINA.GroundStation.Controls"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    x:Name="root"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Center">
    <Grid>
        <gslogic:GsTextBox
            x:Name="PART_TextBox"
            MinWidth="40"
            Margin="5,0,0,0"
            Padding="5,0,5,0"
            HorizontalAlignment="{Binding HorizontalAlignment, ElementName=root}"
            HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility, ElementName=root}"
            VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=root}"
            AcceptsReturn="{Binding AcceptsReturn, ElementName=root}"
            AcceptsTab="{Binding AcceptsTab, ElementName=root}"
            Text="{Binding Text, ElementName=root, UpdateSourceTrigger=LostFocus}"
            TextAlignment="{Binding TextAlignment, ElementName=root}"
            TextWrapping="{Binding TextWrapping, ElementName=root}"
            PreviewKeyDown="OnTextBoxPreviewKeyDown"
            TextChanged="OnTextBoxTextChanged"
            LostKeyboardFocus="OnTextBoxLostKeyboardFocus">
            <gslogic:GsTextBox.ToolTip>
                <ToolTip
                    MaxWidth="500"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Content="{Binding ProcessedText, ElementName=root}"
                    HasDropShadow="True">
                    <ToolTip.ContentTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ToolTip.ContentTemplate>
                </ToolTip>
            </gslogic:GsTextBox.ToolTip>
            <gslogic:GsTextBox.Style>
                <Style TargetType="gslogic:GsTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AcceptsReturn, ElementName=root}" Value="True">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="MinHeight" Value="35" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProcessedText, ElementName=root}" Value="{x:Null}">
                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProcessedText, ElementName=root}" Value="">
                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </gslogic:GsTextBox.Style>
        </gslogic:GsTextBox>

        <Popup
            x:Name="PART_CompletionPopup"
            AllowsTransparency="False"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PART_TextBox}"
            HorizontalOffset="0"
            VerticalOffset="2"
            StaysOpen="False"
            Focusable="False">
            <Border
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
                <ScrollViewer
                    MaxHeight="300"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MinWidth="150"
                        MaxWidth="400"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="PART_SymbolsHeader"
                            Margin="5,3,5,2"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SecondaryBrush}"
                            Text="{ns:Loc Lbl_SequenceCategory_Symbol}" />
                        <ListBox
                            x:Name="PART_SymbolsList"
                            Background="Transparent"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            Focusable="False"
                            Foreground="{DynamicResource PrimaryBrush}"
                            MouseUp="OnCompletionListMouseUp" />
                        <TextBlock
                            x:Name="PART_FunctionsHeader"
                            Margin="5,5,5,2"
                            Padding="0,3,0,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SecondaryBrush}"
                            Text="{ns:Loc Lbl_SymbolFunctions}" />
                        <ListBox
                            x:Name="PART_FunctionsList"
                            Background="Transparent"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            Focusable="False"
                            Foreground="{DynamicResource PrimaryBrush}"
                            MouseUp="OnCompletionListMouseUp" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>

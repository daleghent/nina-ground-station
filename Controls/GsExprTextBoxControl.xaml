<UserControl
    x:Class="DaleGhent.NINA.GroundStation.Controls.GsExprTextBoxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gslogic="clr-namespace:DaleGhent.NINA.GroundStation.Controls"
    xmlns:ns="clr-namespace:NINA.Core.Locale;assembly=NINA.Core"
    x:Name="root">
    <UserControl.Resources>
        <!--
            The items must not take focus: clicking one would otherwise pull keyboard focus out of
            the text box, which closes the popup before the click can be committed.
        -->
        <Style x:Key="CompletionItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!--
            Functions are annotated with the number of arguments they accept, and carry N.I.N.A.'s
            own description and usage example as a tooltip. A null ToolTipText yields no tooltip.
        -->
        <DataTemplate x:Key="FunctionCompletionTemplate">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTipText}">
                <TextBlock Text="{Binding Name}" />
                <TextBlock
                    Margin="6,0,0,0"
                    Foreground="{DynamicResource SecondaryBrush}"
                    Text="{Binding ArgumentHint}" />
            </StackPanel>
        </DataTemplate>
        <!--
            Symbols are annotated with the source that publishes them, which many symbols do not
            declare, so the annotation collapses when it is empty rather than leaving a gap.
        -->
        <DataTemplate x:Key="SymbolCompletionTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" />
                <TextBlock
                    Margin="6,0,0,0"
                    Foreground="{DynamicResource SecondaryBrush}"
                    Text="{Binding Category}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Border
            x:Name="PART_ExprBorder"
            HorizontalAlignment="Stretch"
            BorderBrush="{DynamicResource ButtonForegroundBrush}"
            BorderThickness="1"
            CornerRadius="2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AcceptsReturn, ElementName=root}" Value="True">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <gslogic:GsTextBox
                x:Name="PART_TextBox"
                MinWidth="40"
                Padding="5,0,5,0"
                HorizontalAlignment="Stretch"
                HorizontalScrollBarVisibility="{Binding HorizontalScrollBarVisibility, ElementName=root}"
                VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=root}"
                AcceptsReturn="{Binding AcceptsReturn, ElementName=root}"
                AcceptsTab="{Binding AcceptsTab, ElementName=root}"
                Text="{Binding Text, ElementName=root, UpdateSourceTrigger=LostFocus}"
                TextAlignment="{Binding TextAlignment, ElementName=root}"
                TextWrapping="{Binding TextWrapping, ElementName=root}"
                PreviewKeyDown="OnTextBoxPreviewKeyDown"
                TextChanged="OnTextBoxTextChanged"
                LostKeyboardFocus="OnTextBoxLostKeyboardFocus">
            <gslogic:GsTextBox.ToolTip>
                <ToolTip
                    MaxWidth="500"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Content="{Binding ProcessedText, ElementName=root}"
                    HasDropShadow="True">
                    <ToolTip.ContentTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="5"
                                Foreground="{DynamicResource PrimaryBrush}"
                                Text="{Binding}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ToolTip.ContentTemplate>
                </ToolTip>
            </gslogic:GsTextBox.ToolTip>
            <gslogic:GsTextBox.Style>
                <Style TargetType="gslogic:GsTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AcceptsReturn, ElementName=root}" Value="True">
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="MinHeight" Value="35" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProcessedText, ElementName=root}" Value="{x:Null}">
                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProcessedText, ElementName=root}" Value="">
                            <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </gslogic:GsTextBox.Style>
            </gslogic:GsTextBox>
        </Border>

        <Popup
            x:Name="PART_CompletionPopup"
            AllowsTransparency="False"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PART_TextBox}"
            HorizontalOffset="0"
            VerticalOffset="2"
            StaysOpen="False"
            Focusable="False">
            <Border
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                PreviewMouseWheel="OnCompletionPopupPreviewMouseWheel">
                <ScrollViewer
                    x:Name="PART_CompletionScrollViewer"
                    MaxHeight="300"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MinWidth="150"
                        MaxWidth="400"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="PART_SymbolsHeader"
                            Margin="5,3,5,2"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SecondaryBrush}"
                            Text="{ns:Loc Lbl_SequenceCategory_Symbol}" />
                        <ListBox
                            x:Name="PART_SymbolsList"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource CompletionItemStyle}"
                            ItemTemplate="{StaticResource SymbolCompletionTemplate}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            MouseUp="OnCompletionListMouseUp" />
                        <TextBlock
                            x:Name="PART_FunctionsHeader"
                            Margin="5,5,5,2"
                            Padding="0,3,0,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SecondaryBrush}"
                            Text="{ns:Loc Lbl_SymbolFunctions}" />
                        <ListBox
                            x:Name="PART_FunctionsList"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource CompletionItemStyle}"
                            ItemTemplate="{StaticResource FunctionCompletionTemplate}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            MouseUp="OnCompletionListMouseUp" />
                        <TextBlock
                            x:Name="PART_TokensHeader"
                            Margin="5,5,5,2"
                            Padding="0,3,0,0"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SecondaryBrush}"
                            Text="Ground Station tokens" />
                        <ListBox
                            x:Name="PART_TokensList"
                            Background="Transparent"
                            BorderThickness="0"
                            DisplayMemberPath="Name"
                            Focusable="False"
                            ItemContainerStyle="{StaticResource CompletionItemStyle}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            MouseUp="OnCompletionListMouseUp" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>

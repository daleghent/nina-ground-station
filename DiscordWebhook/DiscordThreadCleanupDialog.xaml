<Window
    x:Class="DaleGhent.NINA.GroundStation.DiscordWebhook.DiscordThreadCleanupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete old Discord session threads"
    Width="600"
    Height="450"
    MinWidth="450"
    MinHeight="300"
    Background="{DynamicResource BackgroundBrush}"
    Closing="Window_Closing"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryBrush}"
            Text="{Binding StatusText}"
            TextWrapping="Wrap" />

        <ProgressBar
            Grid.Row="1"
            Height="18"
            Margin="0,10,0,10"
            IsIndeterminate="{Binding IsIndeterminate}"
            Maximum="{Binding ProgressMax, Mode=OneWay}"
            Minimum="0"
            Value="{Binding ProgressValue, Mode=OneWay}" />

        <TextBox
            x:Name="LogTextBox"
            Grid.Row="2"
            Padding="5"
            Background="{DynamicResource SecondaryBackgroundBrush}"
            BorderThickness="0"
            FontFamily="Consolas"
            Foreground="{DynamicResource PrimaryBrush}"
            HorizontalScrollBarVisibility="Auto"
            IsReadOnly="True"
            Text="{Binding LogText, Mode=OneWay}"
            TextChanged="LogTextBox_TextChanged"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />

        <StackPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="100"
                Height="25"
                Click="CancelButton_Click"
                IsEnabled="{Binding IsRunning}">
                <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="Cancel" />
            </Button>
            <Button
                Width="100"
                Height="25"
                Margin="10,0,0,0"
                Click="CloseButton_Click"
                IsEnabled="{Binding IsFinished}">
                <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="Close" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
